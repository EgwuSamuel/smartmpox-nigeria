# ── DATABASE ──────────────────────────────────────────────────
# Option A: Supabase (recommended for quick start)
# Get this from: supabase.com → your project → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Option B: Local PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/smartmpox

# ── NASA EARTHDATA (MODIS / Landsat) ─────────────────────────
# Register free at: urs.earthdata.nasa.gov
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ── COPERNICUS ERA5 CLIMATE ───────────────────────────────────
# Register free at: cds.climate.copernicus.eu → API key
CDSAPI_URL=https://cds.climate.copernicus.eu/api/v2
CDSAPI_KEY=

# ── TWITTER / X ACADEMIC API ─────────────────────────────────
# Apply at: developer.twitter.com → Academic Research product track
TWITTER_BEARER_TOKEN=

# ── WHATSAPP BUSINESS API ────────────────────────────────────
# Meta for Developers → WhatsApp → Phone Number ID + Token
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── AFRICA'S TALKING SMS ─────────────────────────────────────
# Register at: africastalking.com (free sandbox for testing)
AT_USERNAME=
AT_API_KEY=

# ── AIRFLOW ──────────────────────────────────────────────────
AIRFLOW_HOME=C:\Users\USER\Desktop\SmartMpox\airflow

# ── LOGGING ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=C:\Users\USER\Desktop\SmartMpox\logs
